// Unit tests for the compute-properties resource formula. Pure Tengo — no
// backend. Run with `pl-tengo test` from workflow/.

test := import("@platforma-sdk/workflow-tengo:test")
exec := import("@platforma-sdk/workflow-tengo:exec")
resources := import(":resources")

f := exec.formula

GIB := 1073741824

// Evaluates a formula the way the exec does: resolve metrics against the
// exec's only input file, then read lineCount from the given value.
evalLines := func(node, lineCount) {
	resolved := f.resolveAst(node, {}, ["input.tsv"])
	resolver := {
		size: func(files) { return 0 },
		lineCount: func(files) { return lineCount }
	}
	return f.evaluateResource(resolved, resolver, "test")
}

TestMemFloor := func() {
	test.isEqual(12 * GIB, evalLines(resources.mem(false, 1), 0))
	test.isEqual(12 * GIB, evalLines(resources.mem(false, 1), 1000001))
	test.isEqual(12 * GIB, evalLines(resources.mem(false, 2), 1000001))
	test.isEqual(12 * GIB, evalLines(resources.mem(true, 0), 1000001))
}

TestMemSingleChain := func() {
	n := 3000001
	test.isEqual(n * 6656 + GIB, evalLines(resources.mem(false, 1), n))
	test.isEqual(n * 6656 + GIB, evalLines(resources.mem(false, 0), n))
}

TestMemPairedChains := func() {
	n := 3000001
	test.isEqual(n * 8192 + GIB, evalLines(resources.mem(false, 2), n))
	test.isEqual(n * 8192 + GIB, evalLines(resources.mem(false, 3), n))
}

TestMemWholeSequence := func() {
	n := 3000001
	test.isEqual(n * 8192 + 4 * GIB, evalLines(resources.mem(true, 0), n))
}

// The request keeps growing with the input: no upper bound.
TestMemNoCap := func() {
	n := 100000001
	test.isEqual(n * 8192 + GIB, evalLines(resources.mem(false, 2), n))
}

TestMemStaticFallback := func() {
	test.isEqual(48 * GIB, f.fallbackOf(resources.mem(false, 1)))
	test.isEqual(48 * GIB, f.fallbackOf(resources.mem(true, 0)))
}
